# Copy to .env.local for local development. Never commit real values.
# Lovable Cloud fills the VITE_SUPABASE_* values automatically inside Lovable.

# Public (browser-safe) values
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SITE_URL=https://www.your-school-domain.edu.bd
# Cloudflare Turnstile public site key (the matching secret is TURNSTILE_SECRET_KEY on the server)
VITE_TURNSTILE_SITE_KEY=

# Server-only secrets: set these as backend/edge-function secrets in Lovable Cloud,
# NEVER with a VITE_ prefix and never in frontend code.
# SUPABASE_SERVICE_ROLE_KEY=
# TURNSTILE_SECRET_KEY=
# RESEND_API_KEY=
# EMAIL_FROM=
# SITE_URL=
# NOTIFY_CRON_SECRET=
# PAYMENT_GATEWAY_STORE_ID=
# PAYMENT_GATEWAY_STORE_PASSWORD=
